<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- La zona clicable tiene 12 px; el pulgar visible es de 6 px (9 al hover).
         PART_Track y comandos PageUp/Down preservan el comportamiento nativo. -->
    <Style x:Key="PalClam.InvisibleRepeat" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PalClam.VerticalThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="{DynamicResource PalClam.Scroll.Thumb}"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Pill" Background="{TemplateBinding Background}"
                            Margin="3,2" CornerRadius="4"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Margin" Value="1.5,2"/>
                            <Setter Property="Background" Value="{DynamicResource PalClam.Scroll.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Pill" Property="Margin" Value="1,2"/>
                            <Setter Property="Background" Value="{DynamicResource PalClam.Scroll.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PalClam.HorizontalThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="{DynamicResource PalClam.Scroll.Thumb}"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Pill" Background="{TemplateBinding Background}"
                            Margin="2,3" CornerRadius="4"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Margin" Value="2,1.5"/>
                            <Setter Property="Background" Value="{DynamicResource PalClam.Scroll.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Pill" Property="Margin" Value="2,1"/>
                            <Setter Property="Background" Value="{DynamicResource PalClam.Scroll.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="PalClam.VerticalScroll" TargetType="{x:Type ScrollBar}">
        <Border Background="Transparent" CornerRadius="6">
            <Track x:Name="PART_Track" IsDirectionReversed="True"
                   Orientation="Vertical"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                  Style="{StaticResource PalClam.InvisibleRepeat}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource PalClam.VerticalThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                  Style="{StaticResource PalClam.InvisibleRepeat}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="PalClam.HorizontalScroll" TargetType="{x:Type ScrollBar}">
        <Border Background="Transparent" CornerRadius="6">
            <Track x:Name="PART_Track" IsDirectionReversed="False"
                   Orientation="Horizontal"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                  Style="{StaticResource PalClam.InvisibleRepeat}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource PalClam.HorizontalThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                  Style="{StaticResource PalClam.InvisibleRepeat}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <!-- Fondos de los campos comunes, incluso en las subventanas. -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource PalClam.Control.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource PalClam.Control.Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PalClam.Control.Outline}"/>
    </Style>
    <!-- Plantilla completa: las plantillas nativas de Windows pintaban el selector
         de BLANCO incluso si se cambiaban Background y Foreground. -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource PalClam.Control.Ink}"/>
        <Setter Property="Background" Value="{DynamicResource PalClam.Control.Surface}"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemShell" Background="{TemplateBinding Background}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemShell" Property="Background"
                                    Value="{DynamicResource PalClam.Control.Highlight}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemShell" Property="Background"
                                    Value="{DynamicResource PalClam.Control.Highlight}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource PalClam.Control.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource PalClam.Control.Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PalClam.Control.Outline}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MaxDropDownHeight" Value="360"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="ComboShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"/>
                        <ToggleButton x:Name="DropToggle" Background="Transparent"
                                      BorderThickness="0" Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent">
                                        <Path Data="M2,4 L7,9 L12,4" Stroke="{DynamicResource PalClam.Control.Ink}"
                                              StrokeThickness="1.7" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="14" Height="12" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Margin="0,0,11,0"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="SelectionHost" IsHitTestVisible="False"
                                          Margin="10,0,30,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed"
                                 Margin="10,3,30,3" Padding="0" BorderThickness="0"
                                 Background="Transparent" Foreground="{TemplateBinding Foreground}"
                                 VerticalContentAlignment="Center" Focusable="True"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Placement="Bottom"
                               PopupAnimation="Fade" Focusable="False">
                            <Border x:Name="DropShell"
                                    MinWidth="{Binding ActualWidth, ElementName=ComboShell}"
                                    Background="{DynamicResource PalClam.Control.Surface}"
                                    BorderBrush="{DynamicResource PalClam.Control.Outline}"
                                    BorderThickness="1" CornerRadius="8" Padding="4"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="SelectionHost" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboShell" Property="BorderBrush"
                                    Value="{DynamicResource PalClam.Control.Focus}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ComboShell" Property="Opacity" Value="0.60"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource PalClam.Control.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource PalClam.Control.Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PalClam.Control.Outline}"/>
    </Style>
    <Style TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="{DynamicResource PalClam.Control.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource PalClam.Control.Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PalClam.Control.Outline}"/>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template" Value="{StaticResource PalClam.VerticalScroll}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Template" Value="{StaticResource PalClam.HorizontalScroll}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
