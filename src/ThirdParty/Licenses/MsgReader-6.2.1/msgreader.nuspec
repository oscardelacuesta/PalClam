<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>MsgReader</id>
    <version>6.2.1</version>
    <authors>Kees van Spelde</authors>
    <owners></owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>Outlook-icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/Sicos1977/MSGReader</projectUrl>
    <description>Read Outlook MSG and EML files without using Outlook. The MSGReader supports MSG E-Mail (also signed), Contact, Appointment, Task, Sticky notes and Contact files.
The EML reader supports MIME 1.0 encoded files.</description>
    <releaseNotes>Version 6.2.1:
• The assemblies are now strong-name signed.
• Fixed a cryptographic exception when reading signed messages.
• RTF decompression failures now throw typed exceptions instead of generic errors.
• Fixed NullReferenceException when detecting the encoding of RTF with sparse font tables.
• Updated NuGet package dependencies.</releaseNotes>
    <copyright>(c)2013-2026 - Kees van Spelde</copyright>
    <tags>Outlook MSG Signed EML Contact Appointment Task</tags>
    <repository type="GitHub" url="https://github.com/Sicos1977/MSGReader" commit="4f8d779b8c23f3f3587cd9de703c255cce7ccdf2" />
